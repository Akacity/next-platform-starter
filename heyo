<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Responsive Website</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background-image: url('your-background.jpg'); /* ← Replace with your background image */
      background-size: cover;
      background-position: center;
      color: white;
      text-align: center;
    }

    header {
      padding: 50px 20px 20px;
      background: rgba(0, 0, 0, 0.6);
    }

    h1 {
      font-size: 2.5em;
      margin: 0;
    }

    .button-container {
      margin: 30px 0;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 15px;
    }

    .custom-button {
      background-color: #007BFF;
      color: white;
      border: none;
      padding: 15px 30px;
      font-size: 1em;
      border-radius: 8px;
      cursor: pointer;
      transition: background-color 0.3s;
    }

    .custom-button:hover {
      background-color: #0056b3;
    }

    .ad-space, .media-section {
      margin: 40px 10px;
      padding: 20px;
      background-color: rgba(255, 255, 255, 0.1);
      border: 2px dashed #ccc;
    }

    .media-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      margin-top: 20px;
    }

    .media-grid img, .media-grid video {
      max-width: 300px;
      width: 100%;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0,0,0,0.4);
    }

    .footer-banner {
      position: fixed;
      bottom: 0;
      width: 100%;
      padding: 10px;
      background-color: rgba(0, 0, 0, 0.7);
    }

    @media (max-width: 600px) {
      h1 {
        font-size: 1.8em;
      }

      .custom-button {
        width: 80%;
        font-size: 1em;
        padding: 12px;
      }

      .button-container {
        flex-direction: column;
        align-items: center;
      }

      .media-grid img, .media-grid video {
        max-width: 90%;
      }
    }
  </style>
</head>
<body>

  <header>
    <h1><!-- Editable Heading -->Welcome to My Custom Page</h1>
  </header>

  <div class="button-container">
    <button class="custom-button" onclick="goToLink(0)">Button One</button>
    <button class="custom-button" onclick="goToLink(1)">Button Two</button>
    <button class="custom-button" onclick="goToLink(2)">Button Three</button>
  </div>

  <!-- Social Bar Ad Placeholder -->
  <div class="ad-space">
    <!-- Insert your social bar ad code here -->
    <p>Social Bar Ad Placeholder</p>
  </div>

  <!-- Media Upload Section -->
  <div class="media-section">
    <h2>📸 Pictures Gallery</h2>
    <!-- Add your image tags below -->
    <div class="media-grid">
      <img src="example-image1.jpg" alt="Example Image 1">
      <img src="example-image2.jpg" alt="Example Image 2">
    </div>

    <h2 style="margin-top: 40px;">🎬 Video Showcase</h2>
    <!-- Add your video tags below -->
    <div class="media-grid">
      <video controls>
        <source src="example-video1.mp4" type="video/mp4">
        Your browser does not support the video tag.
      </video>
      <video controls>
        <source src="example-video2.mp4" type="video/mp4">
        Your browser does not support the video tag.
      </video>
    </div>
  </div>

  <!-- Native Banner Ad Placeholder -->
  <div class="footer-banner">
    <!-- Insert your native banner ad code here -->
    <p>Native Banner Ad Placeholder</p>
  </div>

  <script>
    // Replace these links with your own URLs
    const buttonLinks = [
      "https://example.com/page1", // Button One
      "https://example.com/page2", // Button Two
      "https://example.com/page3"  // Button Three
    ];

    function goToLink(index) {
      const url = buttonLinks[index];
      if (url) {
        window.open(url, "_blank");
      } else {
        alert("Link not set!");
      }
    }
  </script>

</body>
</html>
